{
  "manifest_version": 3,
  "name": "RAMGuard",
  "version": "1.6.3",
  "description": "RAMGuard automatically hibernates inactive tabs after 1 minute — keeps Chrome, Brave, Edge, Opera, Vivaldi fast. 100% free.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RAMGuard"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "commands": {
    "hibernate-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Hibernate Now (free up RAM instantly)"
    }
  },
  "minimum_chrome_version": "102"
}
