{
  "manifest_version": 3,
  "name": "RAMGuard",
  "version": "1.3.0",
  "description": "Smart tab hibernator. Auto-sleeps old tabs after 1 minute. Keeps Chrome fast when you have 20+ tabs. 100% free.",
  "icons": {
    "16": "icons/icon-16-removebg-preview.png",
    "48": "icons/icon-48-removebg-preview.png",
    "128": "icons/icon-128-removebg-preview.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RAMGuard"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "commands": {
    "hibernate-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Hibernate Now (free up RAM instantly)"
    }
  },
  "minimum_chrome_version": "102"
}
